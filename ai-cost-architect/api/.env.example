# --- Claim-extraction LLM provider: openai | anthropic | groq | ollama ---
EXTRACTION_PROVIDER=ollama
EXTRACTION_MODEL=llama3.1
# Leave blank to use the provider's default base URL; set to override (proxy, gateway, etc.)
EXTRACTION_BASE_URL=

# --- Provider credentials (only the one you use needs to be set) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1

# --- Jev (TypeSafe System One) ---
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest

# --- API behavior ---
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
EXTRACTION_TIMEOUT_SECONDS=60
# Reasoning models (GLM etc.) spend this budget on thinking before output —
# if you see "empty content (finish_reason=length)" in the logs, raise this.
EXTRACTION_MAX_TOKENS=4000
JEV_TIMEOUT_SECONDS=30
MAX_CLAIMS=15
# DEBUG adds raw LLM/Jev responses to the logs
LOG_LEVEL=INFO